# EnergyGrid Backend Environment Configuration
# Copy to .env and populate real credentials for local/production environments.
# Never commit .env or real secrets to version control.

ENVIRONMENT=development
APP_NAME=EnergyGrid API
API_V1_PREFIX=/api/v1

# PostgreSQL connection strings (psycopg v3 driver) — replace placeholders before running
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@localhost:5432/energygrid

# Isolated test database URL used by pytest (must target a separate database from DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@localhost:5432/energygrid_test

# Security & Auth (JWT_SECRET_KEY must be >= 32 random chars in staging/production)
JWT_SECRET_KEY=change-me-in-local-dev-only-at-least-32-bytes
ALLOW_DEV_AUTH_BYPASS=false

# Comma-separated or JSON array of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Frontend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Telemetry ingestion limits (optional overrides)
TELEMETRY_MAX_OVERLOAD_FACTOR=3.0
TELEMETRY_ENERGY_TOLERANCE_PCT=0.05
TELEMETRY_ENERGY_TOLERANCE_ABS_KWH=0.0500
TELEMETRY_MAX_BULK_ITEMS=1000
TELEMETRY_MAX_CSV_UPLOAD_BYTES=10485760
TELEMETRY_MAX_CSV_UPLOAD_ROWS=10000
TELEMETRY_FUTURE_SKEW_SECONDS=300

